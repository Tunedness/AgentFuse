{
  "name": "@agentfuse/embeddings-local",
  "version": "0.0.0",
  "description": "Optional local (on-device) embedding backend for AgentFuse semantic loop detection. Nothing depends on it; the CLI finds it by dynamic import.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@agentfuse/core": "*",
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-node": "^1.30.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
