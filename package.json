{
  "name": "agentfuse-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AgentFuse monorepo root — a transparent MCP proxy that acts as a circuit breaker for agent tool calls.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "bench"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && node -e \"require('node:fs').rmSync('coverage',{recursive:true,force:true})\"",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
