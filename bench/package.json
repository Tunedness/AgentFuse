{
  "name": "@agentfuse/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Private benchmark harness for AgentFuse. Never published.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "bench:corpus": "npm run build && node dist/detection/generate.js",
    "bench:detection": "npm run build && node dist/detection/run.js",
    "bench:latency": "npm run build && node dist/latency/run.js"
  },
  "dependencies": {
    "@agentfuse/core": "*",
    "@agentfuse/proxy": "*"
  }
}
